/* GIST TUI styles — edit here, hot-reloads instantly in dev mode */

Screen {
    background: $background;
}

Tree {
    height: 1fr;
    background: $background;
    padding: 1 4 0 4;
    scrollbar-gutter: stable;
}

#browser {
    height: 1fr;
    background: $background;
    padding: 1 4 0 4;
}

Tree > .tree--guides {
    color: $primary-darken-2;
}

Tree > .tree--guides-hover {
    color: $primary;
}

Tree > .tree--guides-selected {
    color: $accent;
}

Tree .tree--cursor {
    background: $primary-darken-3;
    color: $text;
}

#modal-box {
    background: $surface;
    border: solid $accent;
    border-title-color: $accent;
    padding: 1 2;
    width: 60;
    height: auto;
    margin: 4 12;
}

#modal-box Label {
    color: $text-muted;
    margin-bottom: 1;
}

#modal-box Input {
    background: $surface-darken-1;
    border: tall $primary-darken-2;
    color: $text;
}

#modal-box Input:focus {
    border: tall $accent;
}

Footer {
    background: $surface;
    color: $text-muted;
}

#context {
    dock: bottom;
    height: 6;
    padding: 1 4;
    background: $surface-darken-1;
    color: $text;
}

#launcher-box {
    background: $surface;
    border: solid $accent;
    padding: 1 3;
    width: 32;
    height: auto;
    margin: 4 12;
}

#launcher-title {
    color: $accent;
    text-style: bold;
    margin-bottom: 1;
}

#launcher-list {
    color: $text;
    height: auto;
}

#ex-box {
    background: $surface;
    border: solid $primary-darken-1;
    padding: 0 2;
    width: 60;
    height: auto;
    margin: 8 12;
}

#ex-box Input {
    background: $surface-darken-1;
    border: tall $primary-darken-2;
    color: $text;
}

#ex-box Input:focus {
    border: tall $accent;
}

#help-box {
    background: $surface;
    border: solid $primary-darken-1;
    padding: 1 2;
    width: 72;
    height: 40;
    margin: 2 8;
}

#help-title {
    color: $accent;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

#help-scroll {
    height: 1fr;
}

#help-body {
    color: $text;
    height: auto;
}
