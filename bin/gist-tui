#!/usr/bin/env python3
"""GIST TUI — tree or Miller columns for goals/ideas/steps/tasks."""

import copy
import datetime
import json
import os
import pathlib
import secrets
import subprocess
import sys
import warnings

warnings.filterwarnings("ignore", category=RuntimeWarning, message=".*GIL.*")
warnings.filterwarnings("ignore", message=".*Unclosed client session.*")

from rich.panel import Panel
from rich.table import Table
from rich.text import Text
from textual import events
from textual.app import App, ComposeResult
from textual.binding import Binding
from textual.containers import Vertical, VerticalScroll
from textual.screen import ModalScreen
from textual.widgets import Footer, Input, Label, Static

ROOT = pathlib.Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from digest.store import DigestStore

DATA = ROOT / "goals.json"
PREFS = ROOT / "prefs.json"
STORE = DigestStore()

LIGHT_THEMES = {
    "ansi-light", "atom-one-light", "catppuccin-latte",
    "rose-pine-dawn", "solarized-light", "textual-light",
}
DEFAULT_DARK  = "nord"
DEFAULT_LIGHT = "catppuccin-latte"


def _system_is_dark() -> bool:
    try:
        result = subprocess.run(
            ["defaults", "read", "-g", "AppleInterfaceStyle"],
            capture_output=True, text=True,
        )
        return result.returncode == 0 and "dark" in result.stdout.lower()
    except Exception:
        return True


def _load_prefs() -> dict:
    if PREFS.exists():
        try:
            return json.loads(PREFS.read_text())
        except Exception:
            pass
    return {}


def _save_prefs(prefs: dict):
    PREFS.write_text(json.dumps(prefs, indent=2))
DEFAULT_DATA = {"version": 1, "nodes": []}
ROOT_KEY = "__root__"
BADGES = {"goal": "G", "idea": "I", "step": "S", "task": "T", "free": "·"}
CHILD_TYPE = {"goal": "idea", "idea": "step", "step": "task", "task": "free", "free": "free"}
TYPE_ORDER = ["goal", "idea", "step", "task", "free"]
TYPE_LABELS = {
    "goal": "Goals",
    "idea": "Ideas",
    "step": "Steps",
    "task": "Tasks",
    "free": "Free",
}
SORT_OPTIONS = ["manual", "title", "created", "status", "completed", "import", "due"]

# importance: None | 1–5, displayed as !-glyphs prefix
IMPORT_GLYPHS: dict[int | None, str] = {
    None: "",
    1: "! ",
    2: "!! ",
    3: "!!! ",
    4: "!!!! ",
    5: "!!!!! ",
}


def importance_prefix(node: dict) -> str:
    return IMPORT_GLYPHS.get(node.get("importance"), "")


def due_label(node: dict) -> str:
    d = node.get("dueDate")
    return f" due:{d}" if d else ""


def load() -> dict:
    STORE.ensure_ready()
    return STORE.load_goals_data()


def save(data: dict):
    STORE.import_snapshot(data)


def new_id() -> str:
    return secrets.token_hex(3)


def now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).isoformat().replace("+00:00", "Z")


def badge_for(node_type: str) -> str:
    return BADGES.get(node_type, "·")


def status_label(status: str) -> str:
    return {
        "active": "active",
        "completed": "completed",
        "archived": "archived",
    }.get(status, status)


# ── space launcher + ex-mode ──────────────────────────────────────────────────

SPACE_COMMANDS = [
    ("o", "onboard",   "gist-onboard"),
    ("c", "check-in",  "gist-checkin"),
    ("s", "show",      "gist-show"),
    ("p", "prefs",     "__prefs__"),
]

EX_ALIASES = {
    "onboard":  "gist-onboard",
    "checkin":  "gist-checkin",
    "check-in": "gist-checkin",
    "show":     "gist-show",
    "prefs":    "__prefs__",
    "config":   "__prefs__",
    "q":        "__quit__",
    "quit":     "__quit__",
}


class SpaceLauncher(ModalScreen):
    BINDINGS = [Binding("escape", "dismiss(None)", "cancel")]

    def compose(self) -> ComposeResult:
        rows = "\n".join(f"  \\[{k}]  {label}" for k, label, _ in SPACE_COMMANDS)
        with Vertical(id="launcher-box"):
            yield Label("── launch ──", id="launcher-title")
            yield Static(rows, id="launcher-list")

    def on_mount(self):
        self.query_one("#launcher-list").focus()

    def on_key(self, event: events.Key):
        for key, _label, cmd in SPACE_COMMANDS:
            if event.key == key:
                event.stop()
                self.dismiss(cmd)
                return
        if event.key != "escape":
            self.dismiss(None)


class ExMode(ModalScreen):
    BINDINGS = [Binding("escape", "dismiss(None)", "cancel")]

    def compose(self) -> ComposeResult:
        with Vertical(id="ex-box"):
            yield Input(placeholder="onboard · checkin · show · prefs · q", id="ex-input")

    def on_mount(self):
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted):
        self.dismiss(event.value.strip())


class InputModal(ModalScreen):
    """Floating input for rename / add."""

    BINDINGS = [Binding("escape", "dismiss('')", "cancel")]

    def __init__(self, prompt: str, default: str = ""):
        super().__init__()
        self._prompt = prompt
        self._default = default

    def compose(self) -> ComposeResult:
        with Vertical(id="modal-box"):
            yield Label(self._prompt)
            yield Input(value=self._default, id="modal-input")

    def on_mount(self):
        self.query_one(Input).focus()

    def on_input_submitted(self, event: Input.Submitted):
        self.dismiss(event.value.strip())


HELP_SECTIONS = [
    ("navigate", [
        ("j / k",       "move down / up"),
        ("h / l",       "collapse or go to parent / expand or add child"),
        ("gg / G",      "top / bottom"),
        ("↑ ↓ ← →",     "arrow key equivalents"),
    ]),
    ("reorder", [
        ("J / K",       "swap with next / previous sibling"),
        ("tab",         "indent under previous sibling"),
        ("shift+tab",   "unindent to grandparent"),
        ("x",           "cut  (subtree moves with it)"),
        ("y",           "yank / copy"),
        ("p",           "paste under current selection"),
    ]),
    ("add", [
        ("a",           "add child node"),
        ("A",           "add sibling node"),
    ]),
    ("edit", [
        ("r / enter",   "rename"),
        ("i",           "cycle importance  — / ! / !! / !!! / !!!! / !!!!!"),
        ("I",           "set due date  YYYY · YYYY-MM · YYYY-MM-DD"),
        ("T",           "edit tags  (comma-separated)"),
        ("dd",          "mark done"),
        ("D",           "archive"),
        ("u",           "undo"),
    ]),
    ("view", [
        ("v",           "toggle tree ↔ columns"),
        ("c",           "toggle context panel"),
        ("f",           "toggle branch ↔ all-level scope  (columns)"),
        ("s",           "cycle sort  manual/title/created/status/import/due"),
        ("z",           "show / hide archived"),
    ]),
    ("app", [
        ("space",       "launch panel  o=onboard  c=checkin  s=show  p=prefs"),
        (":",           "ex-mode  onboard · checkin · show · prefs · q"),
        ("?",           "this help"),
        ("ctrl+\\",     "theme palette"),
        ("q",           "quit"),
    ]),
]


class HelpModal(ModalScreen):
    BINDINGS = [
        Binding("escape",        "dismiss(None)", "close"),
        Binding("q",             "dismiss(None)", "close"),
        Binding("question_mark", "dismiss(None)", "close"),
        Binding("j",             "scroll_down",   "down", show=False),
        Binding("k",             "scroll_up",     "up",   show=False),
    ]

    def action_scroll_down(self):
        self.query_one("#help-scroll").scroll_down()

    def action_scroll_up(self):
        self.query_one("#help-scroll").scroll_up()

    def compose(self) -> ComposeResult:
        table = Table(box=None, show_header=False, padding=(0, 2, 0, 0), expand=False)
        table.add_column("key",  style="yellow", width=14, no_wrap=True)
        table.add_column("desc", no_wrap=True)
        for section, entries in HELP_SECTIONS:
            table.add_row(f"\n {section}", "", style="bold")
            for key, desc in entries:
                table.add_row(f"  {key}", desc)
        with Vertical(id="help-box"):
            yield Label("GIST — keyboard reference  [dim](j/k · scroll · esc)[/dim]", id="help-title")
            with VerticalScroll(id="help-scroll"):
                yield Static(table, id="help-body")

    def on_mount(self):
        self.query_one("#help-scroll").focus()


class GistBrowser(App):
    CSS_PATH = ROOT / "gist-tui.tcss"

    BINDINGS = [
        Binding("j", "cursor_down", "down", show=False),
        Binding("k", "cursor_up", "up", show=False),
        Binding("down", "cursor_down", "down", show=False),
        Binding("up", "cursor_up", "up", show=False),
        Binding("h", "left_key", "left", show=False),
        Binding("l", "right_key", "right", show=False),
        Binding("left", "left_key", "left", show=False),
        Binding("right", "right_key", "right", show=False),
        Binding("g", "gg_start", "gg…", show=False),
        Binding("G", "go_bottom", "bottom", show=False),
        Binding("J", "move_down", "move↓", show=False),
        Binding("K", "move_up", "move↑", show=False),
        Binding("tab", "indent", "indent", show=False),
        Binding("shift+tab", "unindent", "unindent", show=False),
        Binding("a", "add_child", "add child", show=True),
        Binding("A", "add_sibling", "add sibling", show=True),
        Binding("r", "edit_current", "rename", show=True),
        Binding("enter", "edit_current", "edit", show=False),
        Binding("d", "d_key", "done", show=True),
        Binding("D", "archive", "archive", show=False),
        Binding("f", "toggle_level_scope", "filter all/nested", show=True),
        Binding("s", "cycle_sort", "sort", show=True),
        Binding("v", "toggle_view", "view", show=True),
        Binding("z", "toggle_archived", "archives", show=True),
        Binding("x", "cut", "cut", show=False),
        Binding("y", "yank", "yank", show=False),
        Binding("p", "paste", "paste", show=False),
        Binding("c", "toggle_context", "context", show=False),
        Binding("i", "cycle_importance", "importance", show=True),
        Binding("I", "set_due", "due date", show=False),
        Binding("T", "edit_tags", "tags", show=False),
        Binding("u", "undo", "undo", show=True),
        Binding("question_mark", "help", "help", show=True),
        Binding("space",  "space_launch", "launch", show=False, priority=True),
        Binding("colon",  "ex_mode",      ":cmd",   show=False, priority=True),
        Binding("q", "quit", "quit", show=True),
    ]

    def __init__(self):
        super().__init__()
        self.data = load()
        prefs = _load_prefs()
        if _system_is_dark():
            self.theme = prefs.get("theme_dark", DEFAULT_DARK)
        else:
            self.theme = prefs.get("theme_light", DEFAULT_LIGHT)
        # JSON keys are strings; restore as int-keyed dict
        self.column_sort: dict[int, str] = {
            int(k): v for k, v in prefs.get("column_sort", {}).items()
        }
        self.view_mode = prefs.get("view_mode", "columns")
        self.show_archived = False
        self._gg_pending = False
        self._d_pending = False
        self._status_message = "Ready."
        self._undo_stack: list[dict] = []
        self._cut_id: str | None = None
        self._yank_node: dict | None = None
        self.show_context = True

        self.cursor_memory: dict[str, str] = {}
        self.active_depth = 0
        self.open_depth = 0
        self.columns_state: list[dict] = []
        self.column_scope: dict[int, str] = {}

        saved_expanded = prefs.get("expanded_ids", None)
        self.expanded_ids: set[str] = (
            set(saved_expanded) if saved_expanded is not None
            else self._all_expandable_ids()
        )
        self.tree_cursor_id: str | None = None

    def watch_theme(self, theme: str):
        prefs = _load_prefs()
        key = "theme_light" if theme in LIGHT_THEMES else "theme_dark"
        prefs[key] = theme
        _save_prefs(prefs)

    def compose(self) -> ComposeResult:
        yield Static(id="browser")
        yield Static(id="context")
        yield Footer()

    def on_mount(self):
        self._refresh_view()

    def _set_status(self, message: str):
        self._status_message = message
        self._update_context()

    def _visible_nodes(self) -> list[dict]:
        nodes = self.data["nodes"]
        if not self.show_archived:
            nodes = [n for n in nodes if n["status"] != "archived"]
        if self._cut_id:
            nodes = [n for n in nodes if n["id"] != self._cut_id]
        return nodes

    def _gist_node(self, gid: str | None) -> dict | None:
        if not gid:
            return None
        return next((n for n in self.data["nodes"] if n["id"] == gid), None)

    def _all_expandable_ids(self) -> set[str]:
        """IDs of every node that has at least one visible child — used for full expand."""
        parent_ids = {n.get("parentId") for n in self.data["nodes"] if n.get("parentId")}
        return {n["id"] for n in self.data["nodes"] if n["id"] in parent_ids}

    def _natural_type(self, parent_id: str | None) -> str:
        """Return the type a node should have as a child of parent_id."""
        if parent_id is None:
            return "goal"
        parent = self._gist_node(parent_id)
        return CHILD_TYPE.get(parent["type"], "free") if parent else "goal"

    def _parent_key(self, parent_id: str | None) -> str:
        return parent_id or ROOT_KEY

    def _all_scope_key(self, node_type: str) -> str:
        return f"all:{node_type}"

    def _column_type_for_depth(self, depth: int) -> str:
        return TYPE_ORDER[min(depth, len(TYPE_ORDER) - 1)]

    def _column_scope_for_depth(self, depth: int) -> str:
        return self.column_scope.get(depth, "branch")

    def _column_sort_for_depth(self, depth: int) -> str:
        return self.column_sort.get(depth, "manual")

    def _column_nodes(self, parent_id: str | None) -> list[dict]:
        return [n for n in self._visible_nodes() if n.get("parentId") == parent_id]

    def _sorted_nodes(self, nodes: list[dict], depth: int) -> list[dict]:
        sort_key = self._column_sort_for_depth(depth)
        if sort_key == "title":
            return sorted(nodes, key=lambda n: n["title"].lower())
        if sort_key == "created":
            return sorted(nodes, key=lambda n: n.get("createdAt") or "", reverse=True)
        if sort_key == "status":
            status_rank = {"active": 0, "completed": 1, "archived": 2}
            return sorted(nodes, key=lambda n: (status_rank.get(n["status"], 9), n["title"].lower()))
        if sort_key == "completed":
            return sorted(nodes, key=lambda n: n.get("completedAt") or "", reverse=True)
        if sort_key == "import":
            # high importance (5) first; None sorts last
            return sorted(nodes, key=lambda n: (-(n.get("importance") or 0), n["title"].lower()))
        if sort_key == "due":
            # soonest due first; None sorts last
            return sorted(nodes, key=lambda n: (n.get("dueDate") or "9999", n["title"].lower()))
        return nodes

    def _column_state_for_depth(self, parent_id: str | None, depth: int) -> dict:
        node_type = self._column_type_for_depth(depth)
        scope = self._column_scope_for_depth(depth)
        if scope == "all":
            nodes = [n for n in self._visible_nodes() if n["type"] == node_type]
            selection_key = self._all_scope_key(node_type)
            title = f"All {TYPE_LABELS[node_type]}"
        else:
            nodes = self._column_nodes(parent_id)
            selection_key = self._parent_key(parent_id)
            title = TYPE_LABELS[node_type]
        return {
            "depth": depth,
            "parent_id": parent_id,
            "nodes": self._sorted_nodes(nodes, depth),
            "selection_key": selection_key,
            "scope": scope,
            "node_type": node_type,
            "title": title,
        }

    def _siblings(self, gid: str) -> list[dict]:
        node = self._gist_node(gid)
        return self._column_nodes(node.get("parentId")) if node else []

    def _selected_id_for_parent(self, parent_id: str | None, nodes: list[dict]) -> str | None:
        return self._selected_id_for_key(self._parent_key(parent_id), nodes)

    def _selected_id_for_key(self, selection_key: str, nodes: list[dict]) -> str | None:
        if not nodes:
            return None
        current = self.cursor_memory.get(selection_key)
        valid_ids = {n["id"] for n in nodes}
        if current in valid_ids:
            return current
        selected = nodes[0]["id"]
        self.cursor_memory[selection_key] = selected
        return selected

    def _has_visible_children(self, gid: str | None) -> bool:
        return bool(gid and self._column_nodes(gid))

    def _path_to_node(self, gid: str | None) -> list[str]:
        path: list[str] = []
        while gid:
            path.append(gid)
            node = self._gist_node(gid)
            gid = node.get("parentId") if node else None
        path.reverse()
        return path

    def _sync_selection_to_gid(self, gid: str | None):
        if not gid:
            return
        path = self._path_to_node(gid)
        parent_id = None
        for depth, current_id in enumerate(path):
            self.cursor_memory[self._parent_key(parent_id)] = current_id
            self.cursor_memory[self._all_scope_key(self._column_type_for_depth(depth))] = current_id
            parent_id = current_id
        self.tree_cursor_id = gid
        self.expanded_ids.update(path[:-1])
        self.active_depth = max(0, len(path) - 1)
        self.open_depth = self.active_depth

    def _current_column_parent(self) -> str | None:
        return self.columns_state[self.active_depth]["parent_id"] if self.columns_state else None

    def _current_column_nodes(self) -> list[dict]:
        return self.columns_state[self.active_depth]["nodes"] if self.columns_state else []

    def _current_column_state(self) -> dict | None:
        return self.columns_state[self.active_depth] if self.columns_state else None

    def _current_columns_gid(self) -> str | None:
        column = self._current_column_state()
        if not column:
            return None
        return self._selected_id_for_key(column["selection_key"], column["nodes"])

    def _visible_tree_rows(self) -> list[tuple[dict, int]]:
        rows: list[tuple[dict, int]] = []

        def add_branch(parent_id: str | None, depth: int):
            for node in self._column_nodes(parent_id):
                rows.append((node, depth))
                if node["id"] in self.expanded_ids:
                    add_branch(node["id"], depth + 1)

        add_branch(None, 0)
        return rows

    def _current_tree_gid(self) -> str | None:
        rows = self._visible_tree_rows()
        valid_ids = {node["id"] for node, _depth in rows}
        if self.tree_cursor_id in valid_ids:
            return self.tree_cursor_id
        self.tree_cursor_id = rows[0][0]["id"] if rows else None
        return self.tree_cursor_id

    def _current_gist_id(self) -> str | None:
        return self._current_tree_gid() if self.view_mode == "tree" else self._current_columns_gid()

    def _build_columns_state(self):
        columns: list[dict] = []
        parent_id: str | None = None
        depth = 0
        while depth <= self.open_depth:
            column = self._column_state_for_depth(parent_id, depth)
            columns.append(column)
            selected = self._selected_id_for_key(column["selection_key"], column["nodes"])
            if selected is None or depth == self.open_depth or not self._has_visible_children(selected):
                break
            parent_id = selected
            depth += 1
        self.columns_state = columns or [self._column_state_for_depth(None, 0)]
        self.open_depth = min(self.open_depth, len(self.columns_state) - 1)
        self.active_depth = min(self.active_depth, len(self.columns_state) - 1)

    def _normalize_tree_state(self):
        current = self._current_tree_gid()
        if current:
            self._sync_selection_to_gid(current)
        else:
            roots = self._column_nodes(None)
            if roots:
                self.tree_cursor_id = roots[0]["id"]
                self._sync_selection_to_gid(self.tree_cursor_id)

    def _normalize_columns_state(self):
        if not self.columns_state:
            self.columns_state = [self._column_state_for_depth(None, 0)]
        self.open_depth = min(self.open_depth, len(self.columns_state) - 1)
        self.active_depth = min(self.active_depth, len(self.columns_state) - 1)
        if self.active_depth < 0:
            self.active_depth = 0
        if self.open_depth < 0:
            self.open_depth = 0
        for column in self.columns_state:
            self._selected_id_for_key(column["selection_key"], column["nodes"])

    def _refresh_view(self):
        self._build_columns_state()
        if self.view_mode == "tree":
            self._normalize_tree_state()
        else:
            self._normalize_columns_state()
        self._update_browser()
        self._update_context()

    def _remember_selection(self, parent_id: str | None, gid: str):
        self.cursor_memory[self._parent_key(parent_id)] = gid

    def _remember_selection_for_column(self, column: dict, gid: str):
        self.cursor_memory[column["selection_key"]] = gid

    def _push_undo(self):
        self._undo_stack.append(
            {
                "data": copy.deepcopy(self.data),
                "view_mode": self.view_mode,
                "show_archived": self.show_archived,
                "cursor_memory": copy.deepcopy(self.cursor_memory),
                "active_depth": self.active_depth,
                "open_depth": self.open_depth,
                "column_scope": copy.deepcopy(self.column_scope),
                "column_sort": copy.deepcopy(self.column_sort),
                "expanded_ids": copy.deepcopy(self.expanded_ids),
                "tree_cursor_id": self.tree_cursor_id,
            }
        )

    def _focus_after_hidden(self, parent_id: str | None):
        siblings = self._column_nodes(parent_id)
        if siblings:
            self._sync_selection_to_gid(siblings[0]["id"])
            return
        if parent_id:
            self._sync_selection_to_gid(parent_id)
            return
        self.tree_cursor_id = None

    def _node_actions(self, gid: str | None) -> dict[str, bool | str]:
        node = self._gist_node(gid)
        has_children = self._has_visible_children(gid)
        if not node:
            return {
                "can_add_child": True,
                "can_add_sibling": True,
                "can_move_up": False,
                "can_move_down": False,
                "can_indent": False,
                "can_unindent": False,
                "can_edit": False,
                "can_done": False,
                "can_archive": False,
                "has_children": False,
                "open_state": "closed",
            }
        sibs = self._siblings(gid)
        idx = next((i for i, n in enumerate(sibs) if n["id"] == gid), None)
        if self.view_mode == "tree":
            open_state = "open" if gid in self.expanded_ids else "closed"
        else:
            open_state = "open" if self.active_depth < self.open_depth else "closed"
        return {
            "can_add_child": True,
            "can_add_sibling": True,
            "can_move_up": idx is not None and idx > 0,
            "can_move_down": idx is not None and idx < len(sibs) - 1,
            "can_indent": idx is not None and idx > 0,
            "can_unindent": bool(node.get("parentId")),
            "can_edit": True,
            "can_done": True,
            "can_archive": True,
            "has_children": has_children,
            "open_state": open_state,
        }

    def _max_visible_columns(self) -> int:
        return max(1, min(4, max(1, self.size.width // 24)))

    def _render_columns_browser(self):
        max_cols = self._max_visible_columns()
        end = self.active_depth + 1
        start = max(0, end - max_cols)
        visible_columns = self.columns_state[start:end]

        panels = []
        for column in visible_columns:
            depth = column["depth"]
            nodes = column["nodes"]
            text = Text()
            if not nodes:
                text.append("Nothing here.", style="dim")
            else:
                selected_id = self._selected_id_for_key(column["selection_key"], nodes)
                for i, node in enumerate(nodes):
                    line = Text()
                    imp = importance_prefix(node)
                    if imp:
                        line.append(imp, style="yellow")
                    has_ch = self._has_visible_children(node["id"])
                    label = node["title"] + (" ✓" if node["status"] == "completed" else "")
                    line.append(label)
                    if has_ch:
                        line.append(" ›", style="dim")
                    if node["status"] in ("completed", "archived"):
                        line.stylize("dim")
                    if node["id"] == selected_id:
                        line.stylize("reverse" if depth == self.active_depth else "bold")
                    text.append(line)
                    if i < len(nodes) - 1:
                        text.append("\n")
            sort_mode = self._column_sort_for_depth(depth)
            sort_tag = f" [dim]· {sort_mode}[/dim]" if sort_mode != "manual" else ""
            panels.append(
                Panel(
                    text,
                    title=column["title"] + sort_tag,
                    border_style="yellow" if depth == self.active_depth else "grey35",
                    expand=True,
                )
            )

        grid = Table.grid(expand=True)
        if panels:
            for _ in panels:
                grid.add_column(ratio=1)
            grid.add_row(*panels)
        else:
            grid.add_column(ratio=1)
            grid.add_row(Panel(Text("Nothing here.", style="dim"), title=TYPE_LABELS["goal"], border_style="grey35", expand=True))
        return grid

    def _render_tree_browser(self) -> Panel:
        rows = self._visible_tree_rows()
        current = self._current_tree_gid()
        text = Text()
        if not rows:
            text.append("Nothing here.", style="dim")
        else:
            for i, (node, depth) in enumerate(rows):
                line = Text("  " * depth)
                has_children = self._has_visible_children(node["id"])
                marker = "▼" if node["id"] in self.expanded_ids and has_children else "▶" if has_children else "•"
                line.append(f"{marker} {badge_for(node['type'])}  ")
                imp = importance_prefix(node)
                if imp:
                    line.append(imp, style="yellow")
                label = node["title"] + (" ✓" if node["status"] == "completed" else "")
                line.append(label)
                if node["status"] in ("completed", "archived"):
                    line.stylize("dim")
                if node["id"] == current:
                    line.stylize("reverse")
                text.append(line)
                if i < len(rows) - 1:
                    text.append("\n")
        return Panel(text, title="tree", border_style="yellow")

    def _update_browser(self):
        browser = self.query_one("#browser", Static)
        browser.update(self._render_tree_browser() if self.view_mode == "tree" else self._render_columns_browser())

    def _update_context(self):
        widget = self.query_one("#context", Static)
        if not self.show_context:
            widget.display = False
            return
        widget.display = True
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        actions = self._node_actions(gid)
        body = Text()
        if node:
            parent = self._gist_node(node.get("parentId")) if node.get("parentId") else None
            child_type = CHILD_TYPE.get(node["type"], "free")
            column = self._current_column_state() if self.view_mode == "columns" else None
            scope = column["scope"] if column else "branch"
            sort_mode = self._column_sort_for_depth(self.active_depth)
            imp_val = node.get("importance")
            imp_str = ("!" * imp_val) if imp_val else "—"
            due_str = node.get("dueDate") or "—"
            tags_str = ", ".join(node.get("tags") or []) or "—"
            cut_hint = "  ✂ cut — p to paste" if self._cut_id else ""
            mv = f"{'↑' if actions['can_move_up'] else '·'}{'↓' if actions['can_move_down'] else '·'}"
            body.append(f"{badge_for(node['type'])}  {node['title']}", style="bold")
            body.append(f"  ({status_label(node['status'])})", style="dim")
            if cut_hint:
                body.append(cut_hint, style="yellow")
            body.append("\n")
            body.append(f"↳ {parent['title'] if parent else 'root'}", style="dim")
            body.append(f"   import:{imp_str}  due:{due_str}  tags:{tags_str}  "
                        f"move:{mv}  scope:{scope}  sort:{sort_mode}", style="dim")
            body.append("\n")
            body.append(self._status_message, style="dim italic")
        else:
            body.append("no selection", style="dim")
            body.append(f"\nview:{self.view_mode}", style="dim")
            body.append("\n")
            body.append(self._status_message, style="dim italic")
        widget.update(body)

    def _move_columns_selection(self, delta: int):
        column = self._current_column_state()
        if not column:
            self._set_status("No active column.")
            return
        nodes = column["nodes"]
        if not nodes:
            self._set_status("Nothing to select here.")
            return
        gid = self._selected_id_for_key(column["selection_key"], nodes)
        idx = next((i for i, n in enumerate(nodes) if n["id"] == gid), 0)
        new_idx = max(0, min(len(nodes) - 1, idx + delta))
        if new_idx == idx:
            self._set_status(f"Already at the {'bottom' if delta > 0 else 'top'} of this column.")
            return
        new_gid = nodes[new_idx]["id"]
        self._remember_selection_for_column(column, new_gid)
        if self.active_depth < self.open_depth:
            self.open_depth = self.active_depth + 1 if self._has_visible_children(new_gid) else self.active_depth
        self._refresh_view()

    def _move_tree_selection(self, delta: int):
        rows = self._visible_tree_rows()
        if not rows:
            self._set_status("Nothing to select here.")
            return
        current = self._current_tree_gid()
        idx = next((i for i, (node, _depth) in enumerate(rows) if node["id"] == current), 0)
        new_idx = max(0, min(len(rows) - 1, idx + delta))
        if new_idx == idx:
            self._set_status(f"Already at the {'bottom' if delta > 0 else 'top'} of the tree.")
            return
        node, _depth = rows[new_idx]
        self.tree_cursor_id = node["id"]
        self._remember_selection(node.get("parentId"), node["id"])
        self._refresh_view()

    # ── navigation ────────────────────────────────────────────────────────────

    def action_cursor_down(self):
        if self.view_mode == "tree":
            self._move_tree_selection(1)
        else:
            self._move_columns_selection(1)

    def action_cursor_up(self):
        if self.view_mode == "tree":
            self._move_tree_selection(-1)
        else:
            self._move_columns_selection(-1)

    def action_left_key(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if self.view_mode == "columns":
            if self.active_depth < self.open_depth:
                self.open_depth = self.active_depth
                self._refresh_view()
                self._set_status("Closed child column.")
                return
            if self.active_depth > 0:
                self.active_depth -= 1
                self.open_depth = self.active_depth
                self._refresh_view()
                self._set_status("Moved to parent column.")
                return
            self._set_status("Already at the root column.")
            return

        if not node:
            self._set_status("No node selected.")
            return
        if gid in self.expanded_ids and self._has_visible_children(gid):
            self.expanded_ids.discard(gid)
            self._refresh_view()
            self._set_status("Collapsed branch.")
            return
        parent_id = node.get("parentId")
        if not parent_id:
            self._set_status("Already at the root.")
            return
        self.expanded_ids.discard(parent_id)
        self.tree_cursor_id = parent_id
        self._refresh_view()
        self._set_status("Closed ancestor branch.")

    def action_right_key(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected.")
            return
        if not self._has_visible_children(gid):
            self._set_status("No children to open.")
            return
        if self.view_mode == "columns":
            self.open_depth = self.active_depth + 1
            self.active_depth = self.open_depth
            child_nodes = self._column_nodes(gid)
            if child_nodes:
                child_column = self.columns_state[self.active_depth] if self.active_depth < len(self.columns_state) else self._column_state_for_depth(gid, self.active_depth)
                self._remember_selection_for_column(child_column, child_nodes[0]["id"])
            self._refresh_view()
            self._set_status("Opened child column.")
            return

        if gid not in self.expanded_ids:
            self.expanded_ids.add(gid)
            self._refresh_view()
            self._set_status("Expanded branch.")
            return
        children = self._column_nodes(gid)
        child_id = self._selected_id_for_parent(gid, children)
        if child_id:
            self.tree_cursor_id = child_id
            self._refresh_view()
            self._set_status("Moved into child.")

    def action_gg_start(self):
        if self._gg_pending:
            if self.view_mode == "tree":
                rows = self._visible_tree_rows()
                if rows:
                    self.tree_cursor_id = rows[0][0]["id"]
                    self._refresh_view()
                    self._set_status("Moved to top of tree.")
            else:
                column = self._current_column_state()
                nodes = self._current_column_nodes()
                if column and nodes:
                    self._remember_selection_for_column(column, nodes[0]["id"])
                    if self.active_depth < self.open_depth:
                        self.open_depth = self.active_depth + 1 if self._has_visible_children(nodes[0]["id"]) else self.active_depth
                    self._refresh_view()
                    self._set_status("Moved to top of column.")
        self._gg_pending = not self._gg_pending

    def action_go_bottom(self):
        self._gg_pending = False
        if self.view_mode == "tree":
            rows = self._visible_tree_rows()
            if not rows:
                self._set_status("Nothing in the tree.")
                return
            self.tree_cursor_id = rows[-1][0]["id"]
            self._refresh_view()
            self._set_status("Moved to bottom of tree.")
            return
        column = self._current_column_state()
        nodes = self._current_column_nodes()
        if not column or not nodes:
            self._set_status("Nothing in this column.")
            return
        self._remember_selection_for_column(column, nodes[-1]["id"])
        if self.active_depth < self.open_depth:
            self.open_depth = self.active_depth + 1 if self._has_visible_children(nodes[-1]["id"]) else self.active_depth
        self._refresh_view()
        self._set_status("Moved to bottom of column.")

    # ── reorder ───────────────────────────────────────────────────────────────

    def action_move_down(self):
        gid = self._current_gist_id()
        if not gid:
            self._set_status("No node selected.")
            return
        sibs = self._siblings(gid)
        idx = next((i for i, n in enumerate(sibs) if n["id"] == gid), None)
        if idx is None or idx >= len(sibs) - 1:
            self._set_status("Already at the bottom of this level.")
            return
        self._push_undo()
        all_ids = [n["id"] for n in self.data["nodes"]]
        ia = all_ids.index(sibs[idx]["id"])
        ib = all_ids.index(sibs[idx + 1]["id"])
        self.data["nodes"][ia], self.data["nodes"][ib] = self.data["nodes"][ib], self.data["nodes"][ia]
        save(self.data)
        self._sync_selection_to_gid(gid)
        self._refresh_view()
        self._set_status("Moved down.")

    def action_move_up(self):
        gid = self._current_gist_id()
        if not gid:
            self._set_status("No node selected.")
            return
        sibs = self._siblings(gid)
        idx = next((i for i, n in enumerate(sibs) if n["id"] == gid), None)
        if idx is None or idx == 0:
            self._set_status("Already at the top of this level.")
            return
        self._push_undo()
        all_ids = [n["id"] for n in self.data["nodes"]]
        ia = all_ids.index(sibs[idx]["id"])
        ib = all_ids.index(sibs[idx - 1]["id"])
        self.data["nodes"][ia], self.data["nodes"][ib] = self.data["nodes"][ib], self.data["nodes"][ia]
        save(self.data)
        self._sync_selection_to_gid(gid)
        self._refresh_view()
        self._set_status("Moved up.")

    def action_indent(self):
        gid = self._current_gist_id()
        if not gid:
            self._set_status("No node selected.")
            return
        sibs = self._siblings(gid)
        idx = next((i for i, n in enumerate(sibs) if n["id"] == gid), None)
        if idx is None or idx == 0:
            self._set_status("Can't indent the first item at this level.")
            return
        self._push_undo()
        node = self._gist_node(gid)
        new_parent_id = sibs[idx - 1]["id"]
        node["parentId"] = new_parent_id
        node["type"] = self._natural_type(new_parent_id)
        save(self.data)
        self._sync_selection_to_gid(gid)
        self._refresh_view()
        self._set_status(f"Indented → {node['type']}.")

    def action_unindent(self):
        gid = self._current_gist_id()
        if not gid:
            self._set_status("No node selected.")
            return
        node = self._gist_node(gid)
        if not node or not node.get("parentId"):
            self._set_status("Can't unindent a root item.")
            return
        parent = self._gist_node(node["parentId"])
        if not parent:
            self._set_status("Can't unindent without a valid parent.")
            return
        self._push_undo()
        new_parent_id = parent.get("parentId")
        node["parentId"] = new_parent_id
        node["type"] = self._natural_type(new_parent_id)
        save(self.data)
        self._sync_selection_to_gid(gid)
        self._refresh_view()
        self._set_status("Unindented one level.")

    # ── mutations ─────────────────────────────────────────────────────────────

    def action_add_child(self):
        gid = self._current_gist_id()
        parent = self._gist_node(gid) if gid else None
        child_type = CHILD_TYPE.get(parent["type"], "free") if parent else "goal"
        badge = badge_for(child_type)

        async def _do(title: str):
            if not title:
                return
            self._push_undo()
            new_node = {
                "id": new_id(),
                "type": child_type,
                "title": title,
                "status": "active",
                "parentId": gid,
                "importance": None,
                "dueDate": None,
                "tags": [],
                "createdAt": now(),
                "completedAt": None,
            }
            self.data["nodes"].append(new_node)
            save(self.data)
            if gid:
                self.expanded_ids.add(gid)
            self._sync_selection_to_gid(new_node["id"])
            self._refresh_view()
            self._set_status(f"Added {badge} {title}.")

        self.push_screen(InputModal(f"New {badge}  under '{parent['title'] if parent else 'root'}'"), _do)

    def action_add_sibling(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        sib_type = node["type"] if node else "goal"
        parent_id = node.get("parentId") if node else None
        badge = badge_for(sib_type)

        async def _do(title: str):
            if not title:
                return
            self._push_undo()
            new_node = {
                "id": new_id(),
                "type": sib_type,
                "title": title,
                "status": "active",
                "parentId": parent_id,
                "importance": None,
                "dueDate": None,
                "tags": [],
                "createdAt": now(),
                "completedAt": None,
            }
            self.data["nodes"].append(new_node)
            save(self.data)
            self._sync_selection_to_gid(new_node["id"])
            self._refresh_view()
            self._set_status(f"Added {badge} {title}.")

        self.push_screen(InputModal(f"New {badge}  sibling"), _do)

    def action_edit_current(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected to edit.")
            return

        async def _do(title: str):
            if not title:
                return
            self._push_undo()
            node["title"] = title
            save(self.data)
            self._sync_selection_to_gid(gid)
            self._refresh_view()
            self._set_status(f"Renamed to {title}.")

        self.push_screen(InputModal("Edit title:", node["title"]), _do)

    def action_d_key(self):
        if self._d_pending:
            self._d_pending = False
            gid = self._current_gist_id()
            node = self._gist_node(gid)
            if not node:
                self._set_status("No node selected to complete.")
                return
            self._push_undo()
            node["status"] = "completed"
            node["completedAt"] = now()
            save(self.data)
            self._sync_selection_to_gid(gid)
            self._refresh_view()
            self._set_status(f"Completed {node['title']}.")
        else:
            self._d_pending = True
            self._set_status("Press d again to mark complete.")

    def action_archive(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected to archive.")
            return
        self._push_undo()
        parent_id = node.get("parentId")
        title = node["title"]
        node["status"] = "archived"
        save(self.data)
        if self.show_archived:
            self._sync_selection_to_gid(gid)
        else:
            self._focus_after_hidden(parent_id)
        self._refresh_view()
        self._set_status(f"Archived {title}.")

    def action_toggle_context(self):
        self.show_context = not self.show_context
        self._update_context()

    def action_cut(self):
        gid = self._current_gist_id()
        if not gid:
            self._set_status("No node selected.")
            return
        node = self._gist_node(gid)
        self._cut_id = gid
        self._refresh_view()
        self._set_status(f"Cut: {node['title']} — navigate to new parent, press p.")

    def action_yank(self):
        """Copy current node (deep copy — paste re-parents the duplicate)."""
        import copy as _copy
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected.")
            return
        self._cut_id = None  # yank replaces any active cut
        self._yank_node = _copy.deepcopy(node)
        self._set_status(f"Yanked: {node['title']} — navigate to new parent, press p.")

    def action_paste(self):
        target_gid = self._current_gist_id()
        if self._cut_id:
            if target_gid == self._cut_id:
                self._set_status("Can't paste a node onto itself.")
                return
            node = self._gist_node(self._cut_id)
            if not node:
                self._cut_id = None
                self._set_status("Cut node no longer exists.")
                return
            self._push_undo()
            node["parentId"] = target_gid
            node["type"] = self._natural_type(target_gid)
            self._cut_id = None
            save(self.data)
            self._sync_selection_to_gid(node["id"])
        elif self._yank_node:
            import copy as _copy
            self._push_undo()
            dupe = _copy.deepcopy(self._yank_node)
            dupe["id"] = new_id()
            dupe["parentId"] = target_gid
            dupe["type"] = self._natural_type(target_gid)
            dupe["createdAt"] = now()
            dupe["completedAt"] = None
            self.data["nodes"].append(dupe)
            save(self.data)
            self._sync_selection_to_gid(dupe["id"])
        else:
            self._set_status("Nothing to paste. Press x (cut) or y (yank) first.")
            return
        self._refresh_view()
        target = self._gist_node(target_gid)
        dest = target["title"] if target else "root"
        self._set_status(f"Pasted under '{dest}'.")

    def action_edit_tags(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected.")
            return
        current = ", ".join(node.get("tags") or [])

        async def _do(val: str):
            self._push_undo()
            node["tags"] = [t.strip() for t in val.split(",") if t.strip()]
            save(self.data)
            self._sync_selection_to_gid(gid)
            self._refresh_view()
            label = ", ".join(node["tags"]) or "none"
            self._set_status(f"Tags: {label}.")

        self.push_screen(InputModal("Tags (comma-separated, blank to clear):", current), _do)

    def action_cycle_importance(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected.")
            return
        self._push_undo()
        cur = node.get("importance")
        node["importance"] = None if cur == 5 else (cur or 0) + 1
        save(self.data)
        self._sync_selection_to_gid(gid)
        self._refresh_view()
        label = f"{'!' * node['importance']}" if node["importance"] else "none"
        self._set_status(f"Importance: {label}.")

    def action_set_due(self):
        gid = self._current_gist_id()
        node = self._gist_node(gid)
        if not node:
            self._set_status("No node selected.")
            return

        async def _do(val: str):
            if val == "":
                self._push_undo()
                node["dueDate"] = None
                save(self.data)
                self._sync_selection_to_gid(gid)
                self._refresh_view()
                self._set_status("Due date cleared.")
                return
            # accept YYYY, YYYY-MM, or YYYY-MM-DD
            parts = val.split("-")
            valid = (
                len(parts) in (1, 2, 3)
                and all(p.isdigit() for p in parts)
                and len(parts[0]) == 4
                and (len(parts) < 2 or 1 <= int(parts[1]) <= 12)
                and (len(parts) < 3 or 1 <= int(parts[2]) <= 31)
            )
            if not valid:
                self._set_status(f"Invalid date '{val}' — use YYYY, YYYY-MM, or YYYY-MM-DD.")
                return
            self._push_undo()
            node["dueDate"] = val
            save(self.data)
            self._sync_selection_to_gid(gid)
            self._refresh_view()
            self._set_status(f"Due: {val}.")

        self.push_screen(InputModal("Due date (YYYY-MM-DD, blank to clear):", node.get("dueDate") or ""), _do)

    def action_toggle_level_scope(self):
        if self.view_mode != "columns":
            self._set_status("All-level view is only for columns mode.")
            return
        gid = self._current_gist_id()
        depth = self.active_depth  # snapshot — _sync_selection_to_gid mutates active_depth
        current = self._column_scope_for_depth(depth)
        new_scope = "all" if current == "branch" else "branch"
        self.column_scope[depth] = new_scope
        if gid:
            if new_scope == "all":
                self.cursor_memory[self._all_scope_key(self._column_type_for_depth(depth))] = gid
            else:
                self._sync_selection_to_gid(gid)
        self._refresh_view()
        label = "all-level" if new_scope == "all" else "branch"
        self._set_status(f"Switched current column to {label} scope.")

    def action_cycle_sort(self):
        if self.view_mode != "columns":
            self._set_status("Sorting is only for columns mode.")
            return
        current = self._column_sort_for_depth(self.active_depth)
        idx = SORT_OPTIONS.index(current)
        new_value = SORT_OPTIONS[(idx + 1) % len(SORT_OPTIONS)]
        self.column_sort[self.active_depth] = new_value
        prefs = _load_prefs()
        prefs["column_sort"] = {str(k): v for k, v in self.column_sort.items()}
        _save_prefs(prefs)
        self._refresh_view()
        self._set_status(f"Sorting current column by {new_value}.")

    def action_toggle_view(self):
        gid = self._current_gist_id()
        self.view_mode = "columns" if self.view_mode == "tree" else "tree"
        if gid:
            self._sync_selection_to_gid(gid)
        prefs = _load_prefs()
        prefs["view_mode"] = self.view_mode
        _save_prefs(prefs)
        self._refresh_view()
        self._set_status(f"Switched to {self.view_mode} view.")

    def action_toggle_archived(self):
        self.show_archived = not self.show_archived
        self._refresh_view()
        self._set_status(f"{'Showing' if self.show_archived else 'Hiding'} archived items.")

    def action_undo(self):
        if not self._undo_stack:
            self._set_status("Nothing to undo.")
            return
        state = self._undo_stack.pop()
        self.data = state["data"]
        self.view_mode = state["view_mode"]
        self.show_archived = state["show_archived"]
        self.cursor_memory = state["cursor_memory"]
        self.active_depth = state["active_depth"]
        self.open_depth = state["open_depth"]
        self.column_scope = state["column_scope"]
        self.column_sort = state["column_sort"]
        self.expanded_ids = state["expanded_ids"]
        self.tree_cursor_id = state["tree_cursor_id"]
        save(self.data)
        self._refresh_view()
        self._set_status("Undid last change.")

    def on_unmount(self):
        prefs = _load_prefs()
        prefs["expanded_ids"] = list(self.expanded_ids)
        _save_prefs(prefs)

    def action_space_launch(self):
        async def _on_result(cmd):
            if cmd:
                await self._handle_launch(cmd)
        self.push_screen(SpaceLauncher(), _on_result)

    def action_ex_mode(self):
        async def _on_result(raw):
            if not raw:
                return
            cmd = EX_ALIASES.get(raw.lower(), raw)
            await self._handle_launch(cmd)
        self.push_screen(ExMode(), _on_result)

    async def _handle_launch(self, cmd: str):
        if cmd == "__quit__":
            self.exit()
        elif cmd == "__prefs__":
            editor = os.environ.get("VISUAL") or os.environ.get("EDITOR", "nano")
            with self.suspend():
                subprocess.run([editor, str(PREFS)])
            prefs = _load_prefs()
            self.column_sort = {int(k): v for k, v in prefs.get("column_sort", {}).items()}
            self._refresh_view()
            self._set_status("Prefs reloaded.")
        else:
            with self.suspend():
                subprocess.run(["claude", f"/{cmd}"])
            self.data = load()
            self._refresh_view()
            self._set_status(f"Returned from {cmd}.")

    def action_help(self):
        self.push_screen(HelpModal())

    def on_key(self, event: events.Key):
        if event.key != "g":
            self._gg_pending = False
        if event.key != "d":
            self._d_pending = False


if __name__ == "__main__":
    GistBrowser().run()
